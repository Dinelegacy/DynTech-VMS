generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  VIEWER
  OPERATOR
  ADMIN
}

enum SubTier {
  FREE_TRIAL   // 2 cameras included (14-Day Trial)
  STARTER      // 4 cameras included (490 SEK/mo)
  PRO_BUSINESS // 16 cameras included (1,490 SEK/mo)
  ENTERPRISE   // Custom camera limit
}

model User {
  id           String   @id @default(uuid())
  fullName     String   @map("full_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(OPERATOR)
  languagePref String   @default("EN") @map("language_pref")
  createdAt    DateTime @default(now()) @map("created_at")

  subscription Subscription?
  cameras      Camera[]

  @@map("users")
}

model Subscription {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  tier         SubTier  @default(FREE_TRIAL)
  maxCameras   Int      @default(2) @map("max_cameras") // 2 for Trial, 4 for Starter, 16 for Pro
  extraCameras Int      @default(0) @map("extra_cameras") // Add-on seats (+75 SEK/camera)
  currency     String   @default("SEK")
  trialEndsAt  DateTime @map("trial_ends_at")
  isActive     Boolean  @default(true) @map("is_active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Camera {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  name               String   // e.g. "CAM-01 Entrance North"
  rtspUrl            String   @map("rtsp_url")
  webrtcStreamId     String?  @unique @map("webrtc_stream_id")
  isDyntechHardware Boolean  @default(false) @map("is_dyntech_hardware")
  aiDetectionEnabled Boolean  @default(true) @map("ai_detection_enabled")
  createdAt          DateTime @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertLogs AlertLog[]

  @@map("cameras")
}

model AlertLog {
  id          String   @id @default(uuid())
  cameraId    String   @map("camera_id")
  eventType   String   @map("event_type") // 'PERSON', 'MOTION', 'INTRUDER'
  confidence  Float
  boundingBox Json?    @map("bounding_box") // { x, y, width, height }
  timestamp   DateTime @default(now())

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@map("alert_logs")
}